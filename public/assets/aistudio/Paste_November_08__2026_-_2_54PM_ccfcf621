// ========================================== 
// 1. HOME TAB (Kasir Multi-Item Gabungan & Omset) 
// ========================================== 
function HomeTab({ transactions, setTransactions, formatCurrency, currentUser, branches, adminSelectedBranch, setAdminSelectedBranch, inventory, setInventory, masterPrices, members, setMembers, activeBranchName, showToast }) { 
  const [activeModal, setActiveModal] = useState(false);

  const getLocalYMD = () => { 
    const d = new Date(); 
    return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`; 
  }; 
  const [selectedDate, setSelectedDate] = useState(getLocalYMD());

  const dailyTransactions = transactions.filter(tx => tx.date === selectedDate); 
  const totalOmset = dailyTransactions.reduce((acc, curr) => acc + curr.price, 0) || 0;

  const getBestSellers = () => { 
    const now = new Date(); 
    let seed = now.getFullYear() * 10000 + (now.getMonth() + 1) * 100 + now.getDate(); 
    if (now.getHours() < 7) seed -= 1;

    const targetNames = ['VC Scandal', 'PL Romantichwish', 'Pink Shiffon', 'ES Cherry', 'Air ZR Nude']; 
    const availableTargets = inventory.filter(inv => inv.branchName === activeBranchName && inv.type === 'Bibit' && targetNames.includes(inv.name));

    const rotated = [...availableTargets].sort((a, b) => { 
      const hashA = (a.name.charCodeAt(0) * seed) % 100; 
      const hashB = (b.name.charCodeAt(0) * seed) % 100; 
      return hashB - hashA; 
    });

    return rotated.slice(0, 3); 
  }; 
  const currentBestSellers = getBestSellers(); 
  const branchInventory = inventory.filter(inv => inv.branchName === activeBranchName);
  const bibitInventory = branchInventory.filter(inv => inv.type === 'Bibit');

  const [cartItems, setCartItems] = useState([]); 
  const [selectedBibitId, setSelectedBibitId] = useState(bibitInventory.length > 0 ? bibitInventory[0].id : '');
  const [inputMl, setInputMl] = useState(10);
  
  const [botolPcs, setBotolPcs] = useState(1);
  const [botolMl, setBotolMl] = useState(10);
  
  const [selectedMemberId, setSelectedMemberId] = useState(''); 
  const [newMemberName, setNewMemberName] = useState(''); 
  const [newMemberPhone, setNewMemberPhone] = useState('');
  const [newMemberId, setNewMemberId] = useState('');

  const handleAddBibitToCart = () => {
    const item = bibitInventory.find(i => i.id === Number(selectedBibitId));
    if (!item) return alert("Pilih bibit yang valid!");
    if (inputMl <= 0) return alert("Masukkan takaran ml bibit!");

    const pricePerMl = masterPrices.bibit[item.name] || 2500;

    setCartItems(prev => [
      ...prev,
      {
        cartId: Date.now() + Math.random(),
        bibitId: item.id,
        name: item.name,
        ml: Number(inputMl),
        pricePerMl: pricePerMl,
        subtotal: pricePerMl * Number(inputMl)
      }
    ]);
    showToast(`Berhasil menambahkan ${item.name} (${inputMl}ml) ke keranjang.`);
  };

  const handleRemoveCartItem = (cartId) => {
    setCartItems(prev => prev.filter(c => c.cartId !== cartId));
  };

  const totalBibitPrice = cartItems.reduce((acc, curr) => acc + curr.subtotal, 0);
  const baseBotolPrice = masterPrices.botol[botolMl] || Math.round(((masterPrices.botol[30] || 7000) / 30) * botolMl);
  const totalBotolPrice = baseBotolPrice * Number(botolPcs);
  const grandTotal = totalBibitPrice + totalBotolPrice;

  const handleSalesProcess = () => {
    if (cartItems.length === 0 && botolPcs <= 0) {
      return alert("Keranjang masih kosong! Tambahkan minimal 1 item bibit atau botol.");
    }

    let finalMember = null; 
    let earnedPoints = 0;

    if (selectedMemberId === 'new') { 
      if (!newMemberName.trim()) return alert("Nama member baru wajib diisi!"); 
      earnedPoints = Math.floor(grandTotal / 10000); 
      const generatedId = newMemberId.trim() || String(Math.floor(100000 + Math.random() * 900000));
      const newMem = { id: generatedId, name: newMemberName, phone: newMemberPhone || '-', points: earnedPoints }; 
      setMembers(prev => [...prev, newMem]); 
      finalMember = newMem; 
    } else if (selectedMemberId) { 
      finalMember = members.find(m => String(m.id) === String(selectedMemberId)); 
      if (finalMember) { 
        earnedPoints = Math.floor(grandTotal / 10000); 
        setMembers(prev => prev.map(m => String(m.id) === String(finalMember.id) ? { ...m, points: m.points + earnedPoints } : m)); 
      } 
    }

    const bibitLabels = cartItems.map(c => `${c.name} ${c.ml}ml`).join(' vs ');
    const botolLabel = botolPcs > 0 ? `dan Botol ${botolMl}ml ${botolPcs}pcs` : '';
    const transactionLabel = [bibitLabels, botolLabel].filter(Boolean).join(' ');

    setInventory(prev => prev.map(inv => {
      if (inv.branchName === activeBranchName) {
        const matchingCartItem = cartItems.find(c => c.bibitId === inv.id);
        if (matchingCartItem) {
          return { ...inv, stock_sisa: Math.max(0, inv.stock_sisa - matchingCartItem.ml) };
        }
        if (inv.type === 'Botol' && inv.ml === Number(botolMl)) {
          return { ...inv, stock_sisa: Math.max(0, inv.stock_sisa - Number(botolPcs)) };
        }
      }
      return inv;
    }));

    setTransactions(prev => [{ 
      id: Date.now(), 
      branchName: activeBranchName, 
      type: 'Kasir Gabungan (Multi-Item)', 
      item: transactionLabel, 
      detail: `Gabungan ${cartItems.length} bibit & ${botolPcs} botol`, 
      price: grandTotal, 
      member: finalMember ? `${finalMember.name} (ID: ${finalMember.id})` : 'Umum', 
      points_earned: earnedPoints, 
      time: new Date().toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' }), 
      date: getLocalYMD() 
    }, ...prev]);

    setCartItems([]);
    setBotolPcs(1);
    setSelectedMemberId(''); 
    setActiveModal(false); 
    showToast("Transaksi gabungan multi-item berhasil diproses!"); 
  };

  const lowStockItems = branchInventory.filter(inv => inv.stock_sisa < 10).slice(0, 4);

  return ( 
    <div className="px-4 py-4 space-y-5"> 
      {currentUser.isAdmin && ( 
        <div className="bg-white border border-gray-100 rounded-[2rem] p-4 shadow-sm"> 
          <p className="text-xs font-bold text-gray-500 mb-3 flex items-center gap-1"><Store size={14}/> Filter Pantauan Admin:</p> 
          <div className="flex gap-2 overflow-x-auto hidescrollbar pb-1"> 
            {branches.map(b => ( 
              <button key={b} onClick={() => setAdminSelectedBranch(b)} className={`px-4 py-2 rounded-full text-xs font-bold whitespace-nowrap shrink-0 transition-colors ${adminSelectedBranch === b ? 'bg-[#1E3A8A] text-white shadow-md' : 'bg-gray-100 text-gray-600 hover:bg-gray-200'}`} > 
                {b} 
              </button> 
            ))} 
          </div> 
        </div> 
      )}

      <div className="bg-gradient-to-br from-[#1E3A8A] to-blue-500 rounded-[2rem] p-6 text-white shadow-xl shadow-blue-900/20 relative overflow-hidden"> 
        <div className="absolute -right-6 -bottom-6 opacity-20 transform -rotate-12"> <TrendingUp size={140} /> </div>
        <div className="relative z-10"> 
          <p className="text-blue-100 text-xs font-medium mb-1">Total Omset ({currentUser.isAdmin ? adminSelectedBranch : currentUser.branchName})</p> 
          <h2 className="text-3xl font-extrabold tracking-tight">{formatCurrency(totalOmset)}</h2> 
          <div className="mt-4 flex items-center justify-between"> 
            <div className="relative flex items-center gap-2 text-xs bg-white/20 w-max px-3 py-1.5 rounded-full backdrop-blur-sm"> 
              <Calendar size={12} /> 
              <input type="date" value={selectedDate} onChange={(e) => setSelectedDate(e.target.value)} className="bg-transparent outline-none text-white font-bold cursor-pointer text-xs [&::-webkit-calendar-picker-indicator]:filter [&::-webkit-calendar-picker-indicator]:invert" /> 
            </div> 
          </div> 
        </div> 
      </div>

      <button onClick={() => { setActiveModal(true); }} className="w-full bg-[#1E3A8A] text-white p-4 rounded-2xl flex items-center justify-center gap-2 shadow-md hover:bg-blue-900 transition-colors"> 
        <ShoppingCart size={24} /> 
        <span className="font-bold">Buka Kasir Penjualan Gabungan (Multi-Item)</span> 
      </button>

      <div> 
        <h3 className="font-bold text-xs text-orange-500 uppercase tracking-wider mb-3 px-2 flex items-center gap-1"> <Award size={16} /> BEST SELLER (HARI INI) </h3> 
        <div className="flex gap-3 overflow-x-auto hidescrollbar pb-2"> 
          {currentBestSellers.length === 0 ? ( 
            <p className="text-xs text-gray-500 italic px-2">Tidak ada item best seller di stok Anda saat ini.</p> 
          ) : ( 
            currentBestSellers.map(inv => ( 
              <div key={inv.id} className="min-w-[140px] bg-gradient-to-br from-orange-50 to-orange-100 border border-orange-200 p-3 rounded-2xl flex flex-col justify-center relative overflow-hidden"> 
                <h4 className="font-bold text-sm text-gray-900 line-clamp-1 relative z-10">{inv.name}</h4> 
                <p className="text-[10px] text-orange-700 font-medium mt-1 relative z-10">Tersedia: {inv.stock_sisa}ml</p> 
              </div> 
            )) 
          )} 
        </div> 
      </div>

      <div> 
        <h3 className="font-bold text-xs text-red-500 uppercase tracking-wider mb-3 px-2 mt-2">⚠️ Stok Menipis ({activeBranchName})</h3> 
        <div className="space-y-2"> 
          {lowStockItems.length === 0 ? ( 
            <p className="text-xs text-gray-500 italic px-2">Tidak ada stok yang di bawah 10.</p> 
          ) : ( 
            lowStockItems.map(inv => ( 
              <div key={inv.id} className="bg-red-50 border border-red-100 p-3 rounded-2xl flex justify-between items-center"> 
                <div> 
                  <h4 className="font-bold text-sm text-gray-900 line-clamp-1"> {inv.type === 'Botol' ? '🫙 Botol ' : '📦 '}{inv.name} </h4> 
                  <p className="text-[10px] text-gray-500">Ukuran: {inv.ml}{inv.type === 'Botol' ? 'pcs' : 'ml'}</p> 
                </div> 
                <div className="bg-red-100 text-red-700 px-2 py-1 rounded-lg text-xs font-bold">Sisa: {inv.stock_sisa}{inv.type === 'Botol' ? 'pcs' : 'ml'}</div> 
              </div> 
            )) 
          )} 
        </div> 
      </div>

      {activeModal && ( 
        <ModalWrapper title="Kasir Gabungan (Multi-Item)" onClose={() => setActiveModal(false)}> 
          <div className="space-y-4"> 
            <div className="bg-blue-50 p-3 rounded-xl border border-blue-100 text-xs text-blue-800">
              Anda dapat menggabungkan beberapa bibit parfum (Contoh: <b>VC Scandal 10ml vs Aquakiss 10ml</b>) serta memilih botol dalam 1 transaksi.
            </div>

            <div className="space-y-2 border-b border-gray-200 pb-4">
              <label className="text-xs font-bold text-gray-500 block">Pilih & Gabungkan Bibit Parfum</label>
              <div className="flex gap-2">
                <select value={selectedBibitId} onChange={e=>setSelectedBibitId(e.target.value)} className="flex-1 bg-gray-50 border border-gray-200 p-2.5 rounded-xl text-xs font-medium outline-none"> 
                  {bibitInventory.length === 0 && <option value="">(Stok kosong)</option>} 
                  {bibitInventory.map(inv => <option key={inv.id} value={inv.id}>{inv.name} (Sisa: {inv.stock_sisa}ml)</option>)} 
                </select>
                <input type="number" min="1" value={inputMl} onChange={e=>setInputMl(Math.max(1, Number(e.target.value)||0))} placeholder="ml" className="w-20 bg-gray-50 border border-gray-200 p-2.5 rounded-xl text-xs font-bold text-center" />
                <button type="button" onClick={handleAddBibitToCart} className="bg-green-600 text-white px-4 rounded-xl text-xs font-bold">Tambah</button>
              </div>
            </div>

            <div>
              <p className="text-xs font-bold text-gray-500 mb-2">Item Bibit Digabungkan ({cartItems.length}):</p>
              {cartItems.length === 0 ? (
                <p className="text-[11px] text-gray-400 italic">Belum ada bibit ditambahkan ke keranjang.</p>
              ) : (
                <div className="space-y-2 max-h-32 overflow-y-auto">
                  {cartItems.map((c) => (
                    <div key={c.cartId} className="flex justify-between items-center bg-gray-50 p-2.5 rounded-xl border border-gray-100 text-xs">
                      <div>
                        <b>{c.name}</b> ({c.ml}ml)
                      </div>
                      <div className="flex items-center gap-3">
                        <span className="font-bold text-blue-600">{formatCurrency(c.subtotal)}</span>
                        <button onClick={() => handleRemoveCartItem(c.cartId)} className="text-red-500"><Trash2 size={14}/></button>
                      </div>
                    </div>
                  ))}
                </div>
              )}
            </div>

            <div className="grid grid-cols-2 gap-3 border-t border-gray-200 pt-3">
              <div>
                <label className="text-xs font-bold text-gray-500 mb-1 block">Jumlah Botol (Pcs)</label>
                <input type="number" min="0" value={botolPcs} onChange={e=>setBotolPcs(Math.max(0, Number(e.target.value)||0))} className="w-full bg-gray-50 border border-gray-200 p-2.5 rounded-xl text-xs font-bold text-center" />
              </div>
              <div>
                <label className="text-xs font-bold text-gray-500 mb-1 block">Ukuran Botol (ml)</label>
                <select value={botolMl} onChange={e=>setBotolMl(Number(e.target.value))} className="w-full bg-gray-50 border border-gray-200 p-2.5 rounded-xl text-xs font-bold text-center">
                  {[10, 15, 20, 30, 50, 100].map(v => <option key={v} value={v}>{v} ml</option>)}
                </select>
              </div>
            </div>

            <div className="bg-gray-50 p-3 rounded-xl border border-gray-200 flex justify-between items-center">
              <span className="text-xs font-bold text-gray-600">Total Keseluruhan:</span>
              <span className="text-base font-black text-blue-600">{formatCurrency(grandTotal)}</span>
            </div>

            <div className="border-t border-gray-200 pt-3"> 
              <label className="text-xs font-bold text-gray-500 block mb-1">Member (Poin Berlaku Global)</label> 
              <select value={selectedMemberId} onChange={e=>setSelectedMemberId(e.target.value)} className="w-full bg-gray-50 border border-gray-200 p-3 rounded-xl outline-none text-xs font-medium"> 
                <option value="">Pelanggan Umum (Tanpa Poin)</option> 
                {members.map(m => <option key={m.id} value={m.id}>{m.name} (ID: {m.id} - Poin: {m.points})</option>)} 
                <option value="new" className="font-bold text-blue-600">+ Tambah Member Baru</option> 
              </select> 
            </div>

            {selectedMemberId === 'new' && ( 
              <div className="bg-blue-50 p-3 rounded-xl border border-blue-100 space-y-2"> 
                <input type="text" placeholder="ID Member (Cth: 120176)" value={newMemberId} onChange={e=>setNewMemberId(e.target.value)} className="w-full bg-white p-2.5 rounded-xl text-xs" />
                <input type="text" placeholder="Nama Member (Cth: Orel)" value={newMemberName} onChange={e=>setNewMemberName(e.target.value)} className="w-full bg-white p-2.5 rounded-xl text-xs" /> 
                <input type="text" placeholder="No Telp (Opsional)" value={newMemberPhone} onChange={e=>setNewMemberPhone(e.target.value)} className="w-full bg-white p-2.5 rounded-xl text-xs" /> 
              </div> 
            )} 

            <button onClick={handleSalesProcess} className="w-full bg-[#1E3A8A] text-white py-3.5 rounded-2xl font-bold shadow-lg mt-2 text-sm">Proses Transaksi Gabungan</button> 
          </div> 
        </ModalWrapper> 
      )} 
    </div> 
  ); 
}

// ========================================== 
// 2. STOCK TAB (Pencarian Stok & Multi-Order Item) 
// ========================================== 
function StockTab({ inventory, setInventory, activeBranchName, stockOrders, setStockOrders, currentUser, showToast }) { 
  const [activeModal, setActiveModal] = useState(false); 
  const [receiveItem, setReceiveItem] = useState(null); 
  const [actualQty, setActualQty] = useState(0);

  const [searchQuery, setSearchQuery] = useState('');

  const [showAddItemModal, setShowAddItemModal] = useState(false);
  const [newItemType, setNewItemType] = useState('Bibit');
  const [newItemName, setNewItemName] = useState('');
  const [newItemMl, setNewItemMl] = useState(30);
  const [newItemStock, setNewItemStock] = useState(50);

  const [orderCart, setOrderCart] = useState([]); 
  const [orderType, setOrderType] = useState('Bibit');
  const [orderItemName, setOrderItemName] = useState('');
  const [orderMl, setOrderMl] = useState(30);
  const [orderQty, setOrderQty] = useState(50);

  const [editStockItem, setEditStockItem] = useState(null);
  const [updatedStockValue, setUpdatedStockValue] = useState(0);

  const branchOrders = stockOrders.filter(o => o.branchName === activeBranchName); 
  const currentBranchInventory = inventory.filter(i => i.branchName === activeBranchName);

  const filteredInventory = currentBranchInventory.filter(i => 
    i.name.toLowerCase().includes(searchQuery.toLowerCase())
  );

  const bibitStock = filteredInventory.filter(i => i.type === 'Bibit' || !i.type); 
  const botolStock = filteredInventory.filter(i => i.type === 'Botol');

  const handleAddOrderToCart = (e) => {
    e.preventDefault();
    if (!orderItemName.trim()) return alert("Nama item order wajib diisi!");
    
    setOrderCart(prev => [
      ...prev,
      {
        id: Date.now() + Math.random(),
        type: orderType,
        itemName: orderItemName.trim(),
        ml: Number(orderMl),
        qty: Number(orderQty)
      }
    ]);
    setOrderItemName('');
    showToast(`Berhasil menambahkan ${orderItemName} ke keranjang order.`);
  };

  const handleRemoveOrderCart = (id) => {
    setOrderCart(prev => prev.filter(o => o.id !== id));
  };

  const handleSendMultiOrder = () => {
    if (orderCart.length === 0) return alert("Keranjang order masih kosong!");

    const batchOrders = orderCart.map(item => ({
      ...item,
      id: Date.now() + Math.random(),
      branchName: activeBranchName,
      status: 'pending',
      date: new Date().toLocaleDateString('id-ID')
    }));

    setStockOrders(prev => [...batchOrders, ...prev]);
    setOrderCart([]);
    setActiveModal(false);
    showToast("Semua item order berhasil digabung dan dikirim ke Admin Pusat!");
  };

  const openReceiveModal = (order) => { 
    setReceiveItem(order); 
    setActualQty(order.qty); 
  };

  const handleReceiveStock = () => { 
    setInventory(prev => { 
      const existIdx = prev.findIndex(i => i.name === receiveItem.itemName && i.branchName === activeBranchName && i.type === receiveItem.type); 
      if (existIdx >= 0) { 
        const updated = [...prev]; 
        updated[existIdx].stock_sisa += actualQty; 
        return updated; 
      } 
      return [...prev, { id: Date.now(), type: receiveItem.type, name: receiveItem.itemName, ml: receiveItem.ml, stock_sisa: actualQty, branchName: activeBranchName }]; 
    }); 
    setStockOrders(prev => prev.map(o => o.id === receiveItem.id ? { ...o, status: 'completed', receivedQty: actualQty } : o)); 
    setReceiveItem(null); 
    showToast(`Stok masuk: ${actualQty} berhasil ditambahkan ke katalog ${activeBranchName}.`); 
  };

  const handleAddNewItem = (e) => {
    e.preventDefault();
    if (!newItemName.trim()) return alert("Nama item produk wajib diisi!");
    
    const existing = inventory.find(i => i.name.toLowerCase() === newItemName.trim().toLowerCase() && i.branchName === activeBranchName && i.type === newItemType);
    if (existing) {
      return alert("Produk dengan nama tersebut sudah ada di katalog cabang ini!");
    }

    setInventory(prev => [
      ...prev,
      {
        id: Date.now(),
        type: newItemType,
        name: newItemName.trim(),
        ml: Number(newItemMl),
        stock_sisa: Number(newItemStock),
        branchName: activeBranchName
      }
    ]);

    setNewItemName('');
    setNewItemStock(50);
    setShowAddItemModal(false);
    showToast(`Produk ${newItemType} baru berhasil ditambahkan!`);
  };

  const handleSaveStockAdmin = () => {
    if (!currentUser.isAdmin) {
      return alert("Hanya Admin Pusat yang dapat mengubah angka sisa stok secara manual!");
    }
    setInventory(prev => prev.map(inv => inv.id === editStockItem.id ? { ...inv, stock_sisa: Number(updatedStockValue) } : inv));
    setEditStockItem(null);
    showToast("Sisa stok berhasil diperbarui oleh Admin.");
  };

  const StockCard = ({ inv }) => ( 
    <div className="bg-white border border-gray-100 rounded-2xl p-3 shadow-sm flex flex-col justify-between relative group"> 
      <div> 
        <h4 className="font-bold text-gray-900 text-sm line-clamp-1 pr-5">{inv.type === 'Botol' ? '🫙 Botol ' : ''}{inv.name}</h4> 
        <p className="text-[10px] text-gray-500 mb-2">Ukuran: {inv.ml}{inv.type === 'Botol' ? 'pcs' : 'ml'}</p> 
      </div> 
      
      <div className="flex items-center justify-between mt-auto">
        <div className={`px-2 py-1.5 rounded-lg text-xs font-bold text-center flex-1 ${inv.stock_sisa <= 10 ? 'bg-red-50 text-red-600' : 'bg-blue-50 text-blue-700'}`}> 
          Sisa: {inv.stock_sisa}{inv.type === 'Botol' ? 'pcs' : 'ml'} 
        </div>
        
        {currentUser.isAdmin && (
          <button 
            onClick={() => { setEditStockItem(inv); setUpdatedStockValue(inv.stock_sisa); }} 
            className="ml-2 bg-gray-100 hover:bg-gray-200 text-gray-700 px-2.5 py-1.5 rounded-lg text-[10px] font-bold"
          >
            Edit Stok
          </button>
        )}
      </div> 
    </div> 
  );

  return ( 
    <div className="px-4 py-4 space-y-6"> 
      <div className="relative">
        <Search className="absolute left-4 top-1/2 -translate-y-1/2 text-gray-400" size={18} />
        <input 
          type="text" 
          placeholder="Cari stock penjualan di cabang..." 
          value={searchQuery} 
          onChange={e => setSearchQuery(e.target.value)} 
          className="w-full bg-white border border-gray-200 pl-11 pr-4 py-3 rounded-2xl text-xs font-medium outline-none shadow-sm focus:border-blue-500" 
        />
      </div>

      <div className="flex gap-2"> 
        <button onClick={() => setShowAddItemModal(true)} className="flex-1 bg-green-600 text-white p-3 rounded-2xl flex items-center justify-center gap-2 shadow-md"> 
          <PlusCircle size={20}/> 
          <span className="font-bold text-xs">Tambah Item Baru</span> 
        </button>
        <button onClick={() => setActiveModal(true)} className="flex-1 bg-[#1E3A8A] text-white p-3 rounded-2xl flex items-center justify-center gap-2 shadow-md"> 
          <Package size={20}/> 
          <span className="font-bold text-xs">Order Multi-Item</span> 
        </button> 
      </div>

      {branchOrders.length > 0 && ( 
        <div> 
          <h3 className="font-bold text-xs text-gray-500 uppercase tracking-wider mb-2 px-2">Status Order Pusat ({activeBranchName})</h3> 
          <div className="space-y-2"> 
            {branchOrders.filter(o => o.status !== 'completed').map(o => ( 
              <div key={o.id} className="bg-white border border-gray-200 p-3 rounded-2xl flex justify-between items-center shadow-sm"> 
                <div> 
                  <p className="font-bold text-sm text-gray-900 line-clamp-1">{o.type === 'Botol' ? '🫙 Botol ' : '📦 '} {o.itemName} ({o.ml}{o.type === 'Botol' ? 'pcs' : 'ml'})</p> 
                  <p className="text-[10px] text-gray-500">Req: {o.qty} | {o.date}</p> 
                </div> 
                {o.status === 'pending' ? ( 
                  <span className="bg-yellow-100 text-yellow-700 px-2 py-1 rounded-lg text-[10px] font-bold">Menunggu</span> 
                ) : ( 
                  <button onClick={() => openReceiveModal(o)} className="bg-green-600 text-white px-3 py-1.5 rounded-lg text-xs font-bold animate-pulse shadow-md">Terima</button> 
                )} 
              </div> 
            ))} 
          </div> 
        </div> 
      )}

      <div> 
        <h3 className="font-bold text-xs text-gray-500 uppercase tracking-wider mb-3 px-2 border-b border-gray-200 pb-2">📦 Stok Bibit Parfum ({activeBranchName})</h3> 
        <div className="grid grid-cols-2 gap-3"> 
          {bibitStock.length === 0 ? <p className="text-xs text-gray-400 p-2 col-span-2">Tidak ada hasil pencarian bibit.</p> : null} 
          {bibitStock.map(inv => <StockCard key={inv.id} inv={inv} />)} 
        </div> 
      </div>

      <div> 
        <h3 className="font-bold text-xs text-gray-500 uppercase tracking-wider mb-3 px-2 border-b border-gray-200 pb-2 mt-4">🫙 Stok Botol ({activeBranchName})</h3> 
        <div className="grid grid-cols-2 gap-3"> 
          {botolStock.length === 0 ? <p className="text-xs text-gray-400 p-2 col-span-2">Tidak ada hasil pencarian botol.</p> : null} 
          {botolStock.map(inv => <StockCard key={inv.id} inv={inv} />)} 
        </div> 
      </div>

      {activeModal && (
        <ModalWrapper title="Order Multi-Item ke Pusat" onClose={() => setActiveModal(false)}>
          <div className="space-y-4">
            <div className="bg-blue-50 p-3 rounded-xl border border-blue-100 text-xs text-blue-800">
              Staff dapat menambahkan beberapa item order sekaligus (Contoh: <i>DHL Blue 11ml</i>, <i>Scandal 11ml</i>) lalu digabung dalam satu kali pengiriman.
            </div>

            <form onSubmit={handleAddOrderToCart} className="space-y-3 bg-gray-50 p-3 rounded-2xl border border-gray-200">
              <div>
                <label className="text-[10px] font-bold text-gray-500 mb-1 block">Kategori</label>
                <select value={orderType} onChange={e=>setOrderType(e.target.value)} className="w-full bg-white border border-gray-200 p-2 rounded-xl text-xs font-bold">
                  <option value="Bibit">Bibit Parfum</option>
                  <option value="Botol">Botol</option>
                </select>
              </div>
              <div>
                <label className="text-[10px] font-bold text-gray-500 mb-1 block">Nama Item Order</label>
                <input type="text" placeholder="Contoh: DHL Blue / Scandal" value={orderItemName} onChange={e=>setOrderItemName(e.target.value)} className="w-full bg-white border border-gray-200 p-2 rounded-xl text-xs" />
              </div>
              <div className="grid grid-cols-2 gap-2">
                <div>
                  <label className="text-[10px] font-bold text-gray-500 mb-1 block">Ukuran ({orderType === 'Botol' ? 'pcs' : 'ml'})</label>
                  <select value={orderMl} onChange={e=>setOrderMl(e.target.value)} className="w-full bg-white border border-gray-200 p-2 rounded-xl text-xs font-bold">
                    {[10, 11, 15, 20, 30, 50, 100].map(v => <option key={v} value={v}>{v}</option>)}
                  </select>
                </div>
                <div>
                  <label className="text-[10px] font-bold text-gray-500 mb-1 block">Jumlah (Qty)</label>
                  <input type="number" min="1" value={orderQty} onChange={e=>setOrderQty(e.target.value)} className="w-full bg-white border border-gray-200 p-2 rounded-xl text-xs font-bold" />
                </div>
              </div>
              <button type="submit" className="w-full bg-green-600 text-white py-2.5 rounded-xl text-xs font-bold shadow-md">+ Tambah ke Keranjang Order</button>
            </form>

            <div>
              <p className="text-xs font-bold text-gray-500 mb-2">Item Order Digabung ({orderCart.length}):</p>
              {orderCart.length === 0 ? (
                <p className="text-[11px] text-gray-400 italic">Belum ada item dalam keranjang order.</p>
              ) : (
                <div className="space-y-2 max-h-32 overflow-y-auto">
                  {orderCart.map((o) => (
                    <div key={o.id} className="flex justify-between items-center bg-gray-50 p-2.5 rounded-xl border border-gray-100 text-xs">
                      <div>
                        <b>{o.itemName}</b> ({o.ml}ml, Qty: {o.qty})
                      </div>
                      <button onClick={() => handleRemoveOrderCart(o.id)} className="text-red-500"><Trash2 size={14}/></button>
                    </div>
                  ))}
                </div>
              )}
            </div>

            <button onClick={handleSendMultiOrder} className="w-full bg-[#1E3A8A] text-white py-3.5 rounded-2xl font-bold shadow-lg text-sm">Kirim Semua Order ke Admin</button>
          </div>
        </ModalWrapper>
      )}

      {showAddItemModal && (
        <ModalWrapper title="Tambah Item Produk Baru" onClose={() => setShowAddItemModal(false)}>
          <form onSubmit={handleAddNewItem} className="space-y-4">
            <div>
              <label className="text-xs font-bold text-gray-500 mb-1 block">Kategori Produk</label>
              <select value={newItemType} onChange={e=>setNewItemType(e.target.value)} className="w-full bg-gray-50 border border-gray-200 p-3 rounded-xl text-sm font-bold">
                <option value="Bibit">Bibit Parfum</option>
                <option value="Botol">Botol</option>
              </select>
            </div>
            <div>
              <label className="text-xs font-bold text-gray-500 mb-1 block">Nama Item Produk</label>
              <input type="text" placeholder={newItemType === 'Bibit' ? "Contoh: Baccarat Extrait" : "Contoh: Botol Kaca Roller"} value={newItemName} onChange={e=>setNewItemName(e.target.value)} required className="w-full bg-gray-50 border border-gray-200 p-3 rounded-xl text-sm" />
            </div>
            <div className="grid grid-cols-2 gap-4">
              <div>
                <label className="text-xs font-bold text-gray-500 mb-1 block">Ukuran ({newItemType === 'Botol' ? 'pcs' : 'ml'})</label>
                <select value={newItemMl} onChange={e=>setNewItemMl(e.target.value)} className="w-full bg-gray-50 border border-gray-200 p-3 rounded-xl text-sm font-bold">
                  {[10, 15, 20, 30, 50, 100].map(v => <option key={v} value={v}>{v} {newItemType === 'Botol' ? 'pcs' : 'ml'}</option>)}
                </select>
              </div>
              <div>
                <label className="text-xs font-bold text-gray-500 mb-1 block">Stok Awal</label>
                <input type="number" min="0" value={newItemStock} onChange={e=>setNewItemStock(e.target.value)} required className="w-full bg-gray-50 border border-gray-200 p-3 rounded-xl text-sm font-bold" />
              </div>
            </div>
            <button type="submit" className="w-full bg-green-600 text-white py-4 rounded-2xl font-bold shadow-lg">Simpan ke Katalog</button>
          </form>
        </ModalWrapper>
      )}

      {editStockItem && (
        <ModalWrapper title="Ubah Sisa Stok (Akses Admin)" onClose={() => setEditStockItem(null)}>
          <div className="space-y-4">
            <div className="bg-yellow-50 p-3 rounded-xl border border-yellow-200 text-xs text-yellow-800">
              Perhatian: Anda sedang mengubah angka sisa stok secara langsung sebagai Admin untuk produk <b>{editStockItem.name}</b> di cabang {activeBranchName}.
            </div>
            <div>
              <label className="text-xs font-bold text-gray-500 mb-1 block">Jumlah Sisa Stok Baru</label>
              <input type="number" min="0" value={updatedStockValue} onChange={e=>setUpdatedStockValue(e.target.value)} className="w-full bg-gray-50 border border-gray-200 p-3 rounded-xl text-center text-lg font-bold" />
            </div>
            <button onClick={handleSaveStockAdmin} className="w-full bg-[#1E3A8A] text-white py-4 rounded-2xl font-bold shadow-lg">Simpan Perubahan Stok</button>
          </div>
        </ModalWrapper>
      )}

      {receiveItem && ( 
        <ModalWrapper title="Penerimaan & Masuk ke Katalog" onClose={() => setReceiveItem(null)}> 
          <div className="space-y-4"> 
            <div className="bg-blue-50 p-4 rounded-xl border border-blue-100 text-sm"> 
              <p>Tipe Item: <b>{receiveItem.type}</b></p> 
              <p>Nama: <b>{receiveItem.type === 'Botol' ? 'Botol ' : ''}{receiveItem.itemName} ({receiveItem.ml}{receiveItem.type === 'Botol' ? 'pcs' : 'ml'})</b></p> 
              <p>Requested Qty: <b>{receiveItem.qty}</b></p> 
            </div> 
            <div> 
              <label className="text-xs font-bold text-gray-500 mb-1 block">Qty Diterima</label> 
              <input type="number" value={actualQty} onChange={e=>setActualQty(Number(e.target.value))} className="w-full bg-gray-50 border border-gray-200 p-3 rounded-xl text-center text-lg font-bold" /> 
            </div> 
            <button onClick={handleReceiveStock} className="w-full bg-green-600 text-white py-4 rounded-2xl font-bold shadow-lg">Konfirmasi & Masukkan ke Katalog Cabang</button> 
          </div> 
        </ModalWrapper> 
      )} 
    </div> 
  ); 
}

