// ========================================== 
// 5. MEMBER TAB (Staff & Admin: Tambah Member & Hapus oleh Admin) 
// ========================================== 
function MemberTab({ members, setMembers, currentUser, showToast }) { 
  const [showModal, setShowModal] = useState(false); 
  const [idMember, setIdMember] = useState('');
  const [name, setName] = useState(''); 
  const [phone, setPhone] = useState(''); 
  const [initialPoints, setInitialPoints] = useState(0);

  const handleAdd = (e) => { 
    e.preventDefault(); 
    if (!name.trim()) return alert("Nama member wajib diisi!"); 
    const finalId = idMember.trim() || String(Math.floor(100000 + Math.random() * 900000));
    
    if(members.some(m => String(m.id) === String(finalId))) {
      return alert("ID Member sudah terdaftar! Gunakan ID lain.");
    }

    setMembers(prev => [{ id: finalId, name: name.trim(), phone: phone || '-', points: Number(initialPoints) || 0 }, ...prev]); 
    setIdMember('');
    setName(''); 
    setPhone(''); 
    setInitialPoints(0);
    setShowModal(false); 
    showToast('Member baru berhasil ditambahkan (Berlaku Global)!'); 
  };

  const handleDeleteMember = (memberId, memberName) => {
    if (!currentUser.isAdmin) {
      return alert("Hanya Admin Pusat yang memiliki hak akses untuk menghapus member!");
    }
    if (confirm(`Hapus member "${memberName}" (ID: ${memberId}) dari daftar global?`)) {
      setMembers(prev => prev.filter(m => String(m.id) !== String(memberId)));
      showToast("Member berhasil dihapus.");
    }
  };

  return ( 
    <div className="px-4 py-4 space-y-4"> 
      <div className="flex justify-between items-center px-1"> 
        <h3 className="font-bold text-xs text-gray-500 uppercase tracking-wider">Daftar Member Global</h3> 
        <button onClick={() => setShowModal(true)} className="bg-[#1E3A8A] text-white px-3 py-1.5 rounded-full text-xs font-bold flex items-center gap-1"><PlusCircle size={14} /> Tambah Member</button> 
      </div> 
      <div className="space-y-3"> 
        {members.map(m => ( 
          <div key={m.id} className="bg-white border border-gray-100 rounded-3xl p-4 shadow-sm flex items-center gap-4"> 
            <div className="w-12 h-12 bg-blue-100 text-blue-700 rounded-full flex items-center justify-center font-bold text-lg">{m.name.charAt(0)}</div> 
            <div className="flex-1">
              <h4 className="font-bold text-gray-900">{m.name} <span className="text-xs font-normal text-gray-400">(ID: {m.id})</span></h4>
              <p className="text-xs text-gray-500">Telp: {m.phone}</p>
            </div> 
            <div className="flex items-center gap-3">
              <div className="bg-blue-600 text-white px-3 py-1.5 rounded-full text-xs font-bold">{m.points} Poin</div> 
              {currentUser.isAdmin && (
                <button onClick={() => handleDeleteMember(m.id, m.name)} className="text-red-500 hover:text-red-700 p-1">
                  <Trash2 size={16} />
                </button>
              )}
            </div>
          </div> 
        ))} 
      </div> 
      {showModal && ( 
        <ModalWrapper title="Tambah Member Baru" onClose={() => setShowModal(false)}> 
          <form onSubmit={handleAdd} className="space-y-4"> 
            <div>
              <label className="text-xs font-bold text-gray-500 mb-1 block">ID Member (Cth: 120176)</label>
              <input type="text" value={idMember} onChange={e=>setIdMember(e.target.value)} placeholder="Contoh: 120176" className="w-full bg-gray-50 border border-gray-200 p-3 rounded-xl text-sm" />
            </div>
            <div>
              <label className="text-xs font-bold text-gray-500 mb-1 block">Nama Member (Cth: Orel)</label>
              <input type="text" value={name} onChange={e=>setName(e.target.value)} placeholder="Contoh: Orel" required className="w-full bg-gray-50 border border-gray-200 p-3 rounded-xl text-sm" /> 
            </div>
            <div>
              <label className="text-xs font-bold text-gray-500 mb-1 block">Nomor Telepon</label>
              <input type="text" value={phone} onChange={e=>setPhone(e.target.value)} placeholder="081234567890" className="w-full bg-gray-50 border border-gray-200 p-3 rounded-xl text-sm" /> 
            </div>
            <div>
              <label className="text-xs font-bold text-gray-500 mb-1 block">Poin Awal</label>
              <input type="number" min="0" value={initialPoints} onChange={e=>setInitialPoints(e.target.value)} placeholder="0" className="w-full bg-gray-50 border border-gray-200 p-3 rounded-xl text-sm font-bold" /> 
            </div>
            <button type="submit" className="w-full bg-[#1E3A8A] text-white py-4 rounded-2xl font-bold shadow-lg">Simpan Member</button> 
          </form> 
        </ModalWrapper> 
      )} 
    </div> 
  ); 
}

