function LoginScreen({ onLogin, adminPassword, setAdminPassword, staffAccounts, showToast }) { 
  const [username, setUsername] = useState(''); 
  const [password, setPassword] = useState(''); 
  const [showId, setShowId] = useState(false); 
  const [showPassword, setShowPassword] = useState(false); 
  const [isLoading, setIsLoading] = useState(false); 
  const [forgotMode, setForgotMode] = useState(false); 
  const [otpStep, setOtpStep] = useState(false); 
  const [otp, setOtp] = useState(''); 
  const [newPassword, setNewPassword] = useState('');

  const handleLogin = (e) => { 
    e.preventDefault(); 
    setIsLoading(true); 
    setTimeout(() => { 
      setIsLoading(false); 
      if (username === 'mckays' && password === adminPassword) { 
        onLogin({ email: 'budayaxwel@gmail.com', username: 'mckays', isAdmin: true, branchName: 'Pusat' }); 
        showToast('Login berhasil sebagai Admin Pusat'); 
        return; 
      } 
      const staff = staffAccounts.find(s => s.username === username && s.password === password); 
      if (staff) { 
        onLogin({ email: `${staff.username}@mckays.com`, username: staff.username, isAdmin: false, branchName: staff.branchName }); 
        showToast(`Berhasil login ke ${staff.branchName}`); 
        return; 
      } 
      alert('ID atau Password salah!'); 
    }, 800); 
  };

  const handleResetPassword = (e) => { 
    e.preventDefault(); 
    if (!otpStep) { 
      alert("Kode OTP telah dikirim ke email admin (Simulasi)"); 
      setOtpStep(true); 
    } else { 
      if (otp === '1234') { 
        setAdminPassword(newPassword); 
        alert("Password admin berhasil direset!"); 
        setForgotMode(false); 
        setOtpStep(false); 
        setOtp(''); 
        setNewPassword(''); 
      } else { 
        alert("Kode OTP salah!"); 
      } 
    } 
  };

  return ( 
    <div className="flex flex-col items-center justify-center min-h-screen bg-gray-50 text-gray-800 font-sans p-4"> 
      <div className="w-full max-w-[420px] bg-white p-8 rounded-[2.5rem] shadow-2xl relative overflow-hidden flex flex-col items-center"> 
        <div className="w-24 h-24 bg-blue-50 rounded-[2rem] border border-blue-100 flex items-center justify-center shadow-inner mb-6 relative"> 
          <div className="absolute inset-0 bg-blue-500/10 blur-xl rounded-full"></div> 
          <div className="w-12 h-12 bg-blue-600 rounded-full flex items-center justify-center shadow-lg relative z-10"> 
            <span className="text-white font-extrabold text-xl">M</span> 
          </div> 
        </div> 
        <h1 className="text-2xl font-extrabold text-gray-900 mb-1">McKays</h1> 
        <p className="text-xs text-gray-500 font-medium mb-6">Sistem Manajemen & Inventaris</p>

        {forgotMode ? ( 
          <form onSubmit={handleResetPassword} className="w-full space-y-4 animate-fade-in"> 
            <p className="text-sm text-gray-600 text-center mb-4">Reset sandi admin pusat</p> 
            {!otpStep ? ( 
              <button type="submit" className="w-full bg-blue-100 text-blue-700 py-4 rounded-2xl font-bold">Kirim OTP ke Email</button> 
            ) : ( 
              <> 
                <input type="text" placeholder="Masukkan 4 digit OTP (Cth: 1234)" value={otp} onChange={e=>setOtp(e.target.value)} className="w-full bg-gray-50 border border-gray-200 px-4 py-4 rounded-2xl text-sm outline-none focus:border-blue-500 text-center tracking-widest" /> 
                <input type="password" placeholder="Sandi Admin Baru" value={newPassword} onChange={e=>setNewPassword(e.target.value)} className="w-full bg-gray-50 border border-gray-200 px-4 py-4 rounded-2xl text-sm outline-none focus:border-blue-500" /> 
                <button type="submit" className="w-full bg-[#1E3A8A] text-white py-4 rounded-2xl font-bold">Simpan Sandi Baru</button> 
              </> 
            )} 
            <button type="button" onClick={() => {setForgotMode(false); setOtpStep(false);}} className="w-full text-gray-400 font-bold text-xs mt-2">Batal & Kembali ke Login</button> 
          </form> 
        ) : ( 
          <form onSubmit={handleLogin} className="w-full space-y-4 animate-fade-in"> 
            <div className="relative"> 
              <UserIcon className="absolute left-4 top-1/2 -translate-y-1/2 text-gray-400" size={20} /> 
              <input type={showId ? "text" : "password"} value={username} onChange={e => setUsername(e.target.value)} placeholder="ID" className="w-full bg-gray-50 border border-gray-200 pl-12 pr-12 py-4 rounded-2xl text-sm outline-none focus:border-blue-500 transition-all font-medium" /> 
              <button type="button" onClick={() => setShowId(!showId)} className="absolute right-4 top-1/2 -translate-y-1/2 text-gray-400 hover:text-blue-600"><Eye size={20} /></button> 
            </div> 
            <div className="relative"> 
              <Lock className="absolute left-4 top-1/2 -translate-y-1/2 text-gray-400" size={20} /> 
              <input type={showPassword ? "text" : "password"} value={password} onChange={e => setPassword(e.target.value)} placeholder="Insert password" className="w-full bg-gray-50 border border-gray-200 pl-12 pr-12 py-4 rounded-2xl text-sm outline-none focus:border-blue-500 transition-all font-medium" /> 
              <button type="button" onClick={() => setShowPassword(!showPassword)} className="absolute right-4 top-1/2 -translate-y-1/2 text-gray-400 hover:text-blue-600"><Eye size={20} /></button> 
            </div> 
            <button type="submit" disabled={isLoading} className="w-full bg-[#1E3A8A] text-white py-4 rounded-2xl font-bold flex justify-center items-center h-[56px] shadow-lg shadow-blue-900/30"> 
              {isLoading ? <div className="w-6 h-6 border-4 border-white border-t-transparent rounded-full animate-spin"></div> : 'LOGIN'} 
            </button> 
          </form> 
        )} 
      </div> 
    </div> 
  ); 
}

