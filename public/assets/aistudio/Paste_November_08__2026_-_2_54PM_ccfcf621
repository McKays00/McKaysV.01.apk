// 6. PROFILE & ADMIN TAB 
// ========================================== 
function ProfileTab({ currentUser, onLogout, members, setMembers, branches, setBranches, staffAccounts, setStaffAccounts, transactions, masterPrices, setMasterPrices, stockOrders, setStockOrders, inventory, setInventory, showToast, isDarkMode, setIsDarkMode, userAvatars, setUserAvatars, zoomLevel, setZoomLevel, showZoomModal, setShowZoomModal, tempImage, setTempImage }) { 
  const [activeAdminModal, setActiveAdminModal] = useState(null);

  const handleImageUpload = (e) => { 
    const file = e.target.files[0]; 
    if (file) { 
      const reader = new FileReader(); 
      reader.onloadend = () => { 
        setTempImage(reader.result);
        setShowZoomModal(true);
      }; 
      reader.readAsDataURL(file); 
    } 
  };

  const pendingOrdersCount = stockOrders.filter(o => o.status === 'pending').length;

  const AdminListItem = ({ icon: Icon, title, subtitle, colorClass, onClick, badge }) => ( 
    <div onClick={onClick} className="bg-white border border-gray-100 rounded-3xl p-4 shadow-sm flex items-center gap-4 cursor-pointer mb-3 relative"> 
      <div className={`w-12 h-12 rounded-full flex items-center justify-center ${colorClass}`}><Icon size={22} /></div> 
      <div className="flex-1"><h4 className="font-bold text-sm text-gray-900">{title}</h4><p className="text-xs text-gray-500">{subtitle}</p></div> 
      {badge > 0 && <span className="absolute top-3 right-10 bg-red-500 text-white w-5 h-5 rounded-full flex items-center justify-center text-[10px] font-bold">{badge}</span>} 
      <ChevronRight size={20} className="text-gray-300" /> 
    </div> 
  );

  return ( 
    <div className="px-4 py-6"> 
      <div className="flex flex-col items-center mb-8"> 
        <label className="w-24 h-24 bg-[#1E3A8A] text-white rounded-full flex items-center justify-center shadow-lg mb-4 border-4 border-white cursor-pointer relative overflow-hidden group"> 
          <input type="file" accept="image/*" className="hidden" onChange={handleImageUpload} /> 
          {userAvatars[currentUser.email] ? (
            <img src={userAvatars[currentUser.email]} alt="profile" style={{ transform: `scale(${zoomLevel})` }} className="w-full h-full object-cover transition-transform" />
          ) : (
            <UserIcon size={40} />
          )} 
          <div className="absolute inset-0 bg-black/40 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity"><Camera size={24} className="text-white" /></div> 
        </label> 
        <h2 className="font-bold text-lg text-gray-900">{currentUser.email}</h2> 
        <p className="text-xs text-gray-400 mt-1 font-semibold">McKays</p> 
      </div>

      {currentUser.isAdmin && ( 
        <div className="mb-6"> 
          <h3 className="font-bold text-xs text-gray-400 uppercase tracking-wider mb-3 px-2">KONTROL SENTRAL ADMIN</h3> 
          <AdminListItem icon={DollarSign} title="Kelola Harga Master" subtitle="Update harga bibit per ml & botol" colorClass="bg-green-50 text-green-600" onClick={() => setActiveAdminModal('price')} /> 
          <AdminListItem icon={Upload} title="Upload List Produk (Cabang)" subtitle="Tambah list massal bibit/botol ke staff" colorClass="bg-purple-50 text-purple-600" onClick={() => setActiveAdminModal('upload_list')} /> 
          <AdminListItem icon={Inbox} title="Kelola Order Stok" subtitle="Persetujuan request barang cabang" colorClass="bg-orange-50 text-orange-600" onClick={() => setActiveAdminModal('orders')} badge={pendingOrdersCount} /> 
          <AdminListItem icon={Store} title="Kelola Toko Cabang & Staff" subtitle="Tambah cabang, staff & password" colorClass="bg-blue-50 text-blue-600" onClick={() => setActiveAdminModal('branch')} /> 
          <AdminListItem icon={Users} title="Reset Poin Member" subtitle="Nol-kan poin seluruh member" colorClass="bg-red-50 text-red-600" onClick={() => setActiveAdminModal('reset_points')} /> 
          <AdminListItem icon={Download} title="Export Laporan Bulanan" subtitle="PDF / Excel omset cabang" colorClass="bg-indigo-50 text-indigo-600" onClick={() => setActiveAdminModal('export')} /> 
        </div> 
      )}

      <div className="mb-6"> 
        <h3 className="font-bold text-xs text-gray-400 uppercase tracking-wider mb-3 px-2">Pengaturan Tampilan</h3> 
        <AdminListItem icon={isDarkMode ? Sun : Moon} title={isDarkMode ? "Mode Terang" : "Mode Gelap"} subtitle="Ubah tema aplikasi" colorClass={isDarkMode ? "bg-yellow-50 text-yellow-600" : "bg-gray-100 text-gray-700"} onClick={() => setIsDarkMode(!isDarkMode)} /> 
      </div> 

      <div onClick={onLogout} className="bg-red-50 border border-red-100 rounded-3xl p-4 flex items-center gap-4 cursor-pointer"> 
        <div className="w-10 h-10 rounded-full bg-red-100 text-red-600 flex items-center justify-center"><LogOut size={20} /></div> 
        <h4 className="font-bold text-sm text-red-600 flex-1">Logout Sistem (Keluar Akun)</h4> 
      </div>

      {activeAdminModal === 'price' && <AdminMasterPriceModal masterPrices={masterPrices} setMasterPrices={setMasterPrices} onClose={() => setActiveAdminModal(null)} showToast={showToast} />} 
      {activeAdminModal === 'upload_list' && <AdminUploadListModal branches={branches} inventory={inventory} setInventory={setInventory} onClose={() => setActiveAdminModal(null)} showToast={showToast} />} 
      {activeAdminModal === 'orders' && <AdminOrderModal stockOrders={stockOrders} setStockOrders={setStockOrders} onClose={() => setActiveAdminModal(null)} showToast={showToast} />} 
      {activeAdminModal === 'branch' && <AdminBranchModal branches={branches} setBranches={setBranches} staffAccounts={staffAccounts} setStaffAccounts={setStaffAccounts} onClose={() => setActiveAdminModal(null)} showToast={showToast} />} 
      {activeAdminModal === 'export' && <AdminExportModal transactions={transactions} onClose={() => setActiveAdminModal(null)} showToast={showToast} />} 

      {showZoomModal && (
        <ModalWrapper title="Sesuaikan Foto Profil" onClose={() => setShowZoomModal(false)}>
          <div className="space-y-4 flex flex-col items-center">
            <div className="w-32 h-32 rounded-full overflow-hidden border-4 border-blue-600 shadow-md">
              <img src={tempImage} alt="Preview" style={{ transform: `scale(${zoomLevel})` }} className="w-full h-full object-cover transition-transform" />
            </div>
            <div className="w-full space-y-2">
              <label className="text-xs font-bold text-gray-500 block text-center">Geser untuk Memperbesar / Memperkecil</label>
              <div className="flex items-center gap-3">
                <button onClick={() => setZoomLevel(prev => Math.max(0.5, prev - 0.1))} className="bg-gray-200 px-3 py-2 rounded-xl font-bold">-</button>
                <input type="range" min="0.5" max="2.5" step="0.1" value={zoomLevel} onChange={e => setZoomLevel(Number(e.target.value))} className="w-full" />
                <button onClick={() => setZoomLevel(prev => Math.min(2.5, prev + 0.1))} className="bg-gray-200 px-3 py-2 rounded-xl font-bold">+</button>
              </div>
            </div>
            <button onClick={() => { setUserAvatars(prev => ({ ...prev, [currentUser.email]: tempImage })); setShowZoomModal(false); showToast('Foto profil berhasil disimpan dan disesuaikan!'); }} className="w-full bg-[#1E3A8A] text-white py-4 rounded-2xl font-bold shadow-lg">Terapkan Foto</button>
          </div>
        </ModalWrapper>
      )}

      {activeAdminModal === 'reset_points' && ( 
        <ModalWrapper title="Reset Poin Member" onClose={() => setActiveAdminModal(null)}> 
          <div className="space-y-4 text-center"> 
            <p className="text-sm text-gray-600 px-4"> Anda yakin ingin mengubah poin <strong className="text-red-600">semua member</strong> menjadi 0? </p> 
            <button onClick={() => { setMembers(members.map(m => ({ ...m, points: 0 }))); showToast('Semua poin member telah di-reset.'); setActiveAdminModal(null); }} className="w-full bg-red-600 text-white py-4 rounded-2xl font-bold shadow-lg" > Ya, Reset Semua Poin </button> 
            <button onClick={() => setActiveAdminModal(null)} className="w-full text-gray-500 font-bold text-xs mt-2">Batal</button> 
          </div> 
        </ModalWrapper> 
      )} 
    </div> 
  ); 
}

function AdminMasterPriceModal({ masterPrices, setMasterPrices, onClose, showToast }) { 
  const [bibitName, setBibitName] = useState(''); 
  const [bibitPrice, setBibitPrice] = useState('');

  const handleUpdateBotol = (ml, val) => { 
    setMasterPrices(prev => ({ ...prev, botol: { ...prev.botol, [ml]: Number(val) }})); 
  };

  const handleAddBibit = (e) => { 
    e.preventDefault(); 
    if(bibitName && bibitPrice) { 
      setMasterPrices(prev => ({ ...prev, bibit: { ...prev.bibit, [bibitName]: Number(bibitPrice) }})); 
      setBibitName(''); 
      setBibitPrice(''); 
      showToast('Harga Bibit berhasil di-update'); 
    } 
  };

  return ( 
    <ModalWrapper title="Kelola Harga Master" onClose={onClose}> 
      <div className="space-y-6"> 
        <div> 
          <h4 className="font-bold text-sm text-gray-800 mb-3 border-b pb-2">Harga Botol (Berdasarkan ML)</h4> 
          <div className="grid grid-cols-2 gap-3"> 
            {Object.keys(masterPrices.botol).map(ml => ( 
              <div key={ml} className="flex flex-col bg-gray-50 p-2 rounded-lg border border-gray-200"> 
                <label className="text-[10px] font-bold text-gray-500 mb-1">{ml} ml</label> 
                <input type="number" value={masterPrices.botol[ml]} onChange={e => handleUpdateBotol(ml, e.target.value)} className="w-full bg-transparent font-bold outline-none" /> 
              </div> 
            ))} 
          </div> 
        </div> 

        <div> 
          <h4 className="font-bold text-sm text-gray-800 mb-3 border-b pb-2">Harga Bibit (Per ML)</h4> 
          <div className="space-y-2 max-h-40 overflow-y-auto hidescrollbar mb-3"> 
            {Object.keys(masterPrices.bibit).map(name => ( 
              <div key={name} className="flex justify-between items-center bg-gray-50 p-3 rounded-lg border border-gray-100"> 
                <span className="font-bold text-sm">{name}</span> 
                <span className="font-bold text-blue-600">Rp {masterPrices.bibit[name]} / ml</span> 
              </div> 
            ))} 
          </div> 
          <form onSubmit={handleAddBibit} className="flex gap-2"> 
            <input type="text" placeholder="Nama Bibit Baru" value={bibitName} onChange={e=>setBibitName(e.target.value)} className="flex-1 border border-gray-200 p-3 rounded-xl text-sm" required /> 
            <input type="number" placeholder="Harga/ml" value={bibitPrice} onChange={e=>setBibitPrice(e.target.value)} className="w-24 border border-gray-200 p-3 rounded-xl text-sm" required /> 
            <button type="submit" className="bg-[#1E3A8A] text-white px-4 rounded-xl font-bold">+</button> 
          </form> 
        </div> 
      </div> 
    </ModalWrapper> 
  ); 
}

function AdminUploadListModal({ branches, inventory, setInventory, onClose, showToast }) { 
  const [targetBranch, setTargetBranch] = useState(branches[0]); 
  const [productType, setProductType] = useState('Bibit'); 
  const [rawText, setRawText] = useState(''); 
  const [defaultStock, setDefaultStock] = useState(50);

  const handleUploadList = (e) => { 
    e.preventDefault(); 
    const lines = rawText.split('\n').map(l => l.trim()).filter(Boolean); 
    if (lines.length === 0) return alert("Masukkan minimal satu nama produk!");

    const newItems = lines.map((name, index) => ({ 
      id: Date.now() + index, 
      type: productType, 
      name: name, 
      ml: productType === 'Botol' ? 30 : 30, 
      stock_sisa: Number(defaultStock), 
      branchName: targetBranch 
    }));

    setInventory(prev => [...prev, ...newItems]); 
    showToast(`Berhasil menambahkan ${lines.length} produk ke ${targetBranch}!`); 
    onClose(); 
  };

  return ( 
    <ModalWrapper title="Upload List Produk (Massal)" onClose={onClose}> 
      <form onSubmit={handleUploadList} className="space-y-4"> 
        <div> 
          <label className="text-xs font-bold text-gray-500 mb-1 block">Pilih Cabang Target Staff</label> 
          <select value={targetBranch} onChange={e=>setTargetBranch(e.target.value)} className="w-full bg-gray-50 border border-gray-200 p-3 rounded-xl text-sm font-bold"> 
            {branches.map(b => <option key={b} value={b}>{b}</option>)} 
          </select> 
        </div> 
        <div> 
          <label className="text-xs font-bold text-gray-500 mb-1 block">Kategori Produk</label> 
          <select value={productType} onChange={e=>setProductType(e.target.value)} className="w-full bg-gray-50 border border-gray-200 p-3 rounded-xl text-sm font-bold"> 
            <option value="Bibit">Bibit Parfum</option> 
            <option value="Botol">Botol</option> 
          </select> 
        </div> 
        <div> 
          <label className="text-xs font-bold text-gray-500 mb-1 block">Stok Awal Masal</label> 
          <input type="number" value={defaultStock} onChange={e=>setDefaultStock(e.target.value)} className="w-full bg-gray-50 border border-gray-200 p-3 rounded-xl text-sm" /> 
        </div> 
        <div> 
          <label className="text-xs font-bold text-gray-500 mb-1 block">Daftar Nama Produk (Enter per baris)</label> 
          <textarea rows={5} placeholder={"Contoh:\nVanilla Lace\nBaccarat Extrait\nBlack Opium"} value={rawText} onChange={e=>setRawText(e.target.value)} required className="w-full bg-gray-50 border border-gray-200 p-3 rounded-xl text-sm" /> 
        </div> 
        <button type="submit" className="w-full bg-[#1E3A8A] text-white py-4 rounded-2xl font-bold shadow-lg">Upload & Masukkan ke Katalog</button> 
      </form> 
    </ModalWrapper> 
  ); 
}

function AdminOrderModal({ stockOrders, setStockOrders, onClose, showToast }) { 
  const handleApprove = (id) => { 
    setStockOrders(prev => prev.map(o => o.id === id ? { ...o, status: 'approved' } : o)); 
    showToast("Order di-Approve. Cabang dapat menekan 'Terima'."); 
  };

  return ( 
    <ModalWrapper title="Kelola Order Stok" onClose={onClose}> 
      <div className="space-y-3"> 
        {stockOrders.length === 0 && <p className="text-center text-gray-400 py-6 text-sm">Tidak ada riwayat order.</p>} 
        {stockOrders.slice().reverse().map(o => ( 
          <div key={o.id} className="bg-gray-50 border border-gray-200 p-4 rounded-2xl"> 
            <div className="flex justify-between items-start mb-2"> 
              <div> 
                <span className="text-[10px] font-bold bg-blue-100 text-blue-700 px-2 py-0.5 rounded-full">{o.branchName}</span> 
                <h4 className="font-bold text-sm text-gray-900 mt-1">{o.type === 'Botol' ? '🫙 Botol ' : '📦 '} {o.itemName} ({o.ml}{o.type === 'Botol' ? 'pcs' : 'ml'})</h4> 
                <p className="text-xs text-gray-500">Request: {o.qty}</p> 
              </div> 
              <div> 
                {o.status === 'pending' && <span className="text-xs font-bold text-yellow-600 bg-yellow-50 px-2 py-1 rounded">Menunggu</span>} 
                {o.status === 'approved' && <span className="text-xs font-bold text-blue-600 bg-blue-50 px-2 py-1 rounded">Di-Approve</span>} 
                {o.status === 'completed' && <span className="text-xs font-bold text-green-600 bg-green-50 px-2 py-1 rounded">Selesai</span>} 
              </div> 
            </div> 
            {o.status === 'pending' && ( 
              <button onClick={() => handleApprove(o.id)} className="w-full mt-2 bg-[#1E3A8A] text-white py-2 rounded-xl text-xs font-bold">Approve & Kirim</button> 
            )} 
          </div> 
        ))} 
      </div> 
    </ModalWrapper> 
  ); 
}

function AdminBranchModal({ branches, setBranches, staffAccounts, setStaffAccounts, onClose, showToast }) { 
  const [newBranchName, setNewBranchName] = useState('');
  const [username, setUsername] = useState(''); 
  const [password, setPassword] = useState(''); 
  const [branchName, setBranchName] = useState(branches[0]);

  const handleAddBranch = (e) => {
    e.preventDefault();
    if(!newBranchName.trim()) return;
    if(branches.includes(newBranchName.trim())) return alert("Nama cabang sudah ada!");
    setBranches(prev => [...prev, newBranchName.trim()]);
    setNewBranchName('');
    showToast("Cabang toko baru berhasil ditambahkan!");
  };

  const handleSaveStaff = (e) => { 
    e.preventDefault();
    if(!username || !password) return; 
    setStaffAccounts(prev => [...prev, { id: Date.now(), username, password, branchName }]); 
    setUsername(''); 
    setPassword(''); 
    showToast('Akun staff baru berhasil dibuat!'); 
  };

  return ( 
    <ModalWrapper title="Kelola Toko Cabang & Staff" onClose={onClose}> 
      <div className="space-y-6"> 
        <form onSubmit={handleAddBranch} className="bg-purple-50 p-4 rounded-xl border border-purple-100 space-y-3">
          <h4 className="font-bold text-sm text-purple-900">Tambah Toko Cabang Baru</h4>
          <input type="text" placeholder="Nama Cabang (Cth: Cabang Surabaya)" value={newBranchName} onChange={e=>setNewBranchName(e.target.value)} className="w-full p-3 rounded-lg border border-gray-200 text-sm outline-none bg-white"/>
          <button type="submit" className="w-full bg-purple-600 text-white py-3 rounded-xl font-bold">Tambah Cabang</button>
        </form>

        <form onSubmit={handleSaveStaff} className="bg-blue-50 p-4 rounded-xl border border-blue-100 space-y-3"> 
          <h4 className="font-bold text-sm text-blue-900">Pendaftaran Akun Staff & Password</h4>
          <input type="text" placeholder="ID Staff (Username)" value={username} onChange={e=>setUsername(e.target.value)} required className="w-full p-3 rounded-lg border border-gray-200 text-sm outline-none bg-white"/> 
          <input type="text" placeholder="Password" value={password} onChange={e=>setPassword(e.target.value)} required className="w-full p-3 rounded-lg border border-gray-200 text-sm outline-none bg-white"/> 
          <select value={branchName} onChange={e=>setBranchName(e.target.value)} className="w-full p-3 rounded-lg border border-gray-200 text-sm outline-none bg-white"> 
            {branches.map(b => <option key={b} value={b}>{b}</option>)} 
          </select> 
          <button type="submit" className="w-full bg-[#1E3A8A] text-white py-3 rounded-xl font-bold">Buat Akun Staf</button> 
        </form> 

        <div>
          <h4 className="font-bold text-sm text-gray-700 mb-2">Daftar Akun Staff Aktif</h4>
          <div className="max-h-36 overflow-y-auto space-y-2"> 
            {staffAccounts.map(s => ( 
              <div key={s.id} className="p-3 bg-gray-50 rounded-xl border border-gray-200 flex justify-between items-center"> 
                <div><p className="font-bold text-sm">{s.username}</p><p className="text-[10px] text-gray-500">{s.branchName} | Sandi: {s.password}</p></div> 
                <button onClick={() => setStaffAccounts(staffAccounts.filter(x=>x.id !== s.id))} className="text-red-500"><Trash2 size={16}/></button> 
              </div> 
            ))} 
          </div>
        </div>
      </div> 
    </ModalWrapper> 
  ); 
}

function AdminExportModal({ transactions, onClose, showToast }) { 
  const exportDummy = (type) => { 
    showToast(`Berhasil mengekspor laporan omset dalam format ${type}.`); 
    setTimeout(onClose, 1000); 
  }; 
  return ( 
    <ModalWrapper title="Export Laporan Bulanan" onClose={onClose}> 
      <div className="grid grid-cols-2 gap-4 mt-4"> 
        <button onClick={()=>exportDummy('PDF')} className="bg-red-600 text-white py-6 rounded-2xl font-bold text-sm flex flex-col justify-center items-center gap-3"><span className="text-3xl">📄</span> Export PDF</button> 
        <button onClick={()=>exportDummy('Excel')} className="bg-green-600 text-white py-6 rounded-2xl font-bold text-sm flex flex-col justify-center items-center gap-3"><span className="text-3xl">📊</span> Export Excel</button> 
      </div> 
    </ModalWrapper> 
  ); 
}

function ModalWrapper({ title, onClose, children }) { 
  return ( 
    <div className="fixed inset-0 z-50 flex flex-col justify-end bg-gray-900/40 backdrop-blur-sm animate-fade-in"> 
      <div className="absolute inset-0" onClick={onClose}></div> 
      <div className="bg-white w-full rounded-t-[2rem] p-6 pb-10 shadow-2xl relative z-50 animate-slide-up max-h-[85vh] overflow-y-auto flex flex-col"> 
        <div className="w-12 h-1.5 bg-gray-200 rounded-full mx-auto mb-6"></div> 
        <div className="flex justify-between items-center mb-6"> 
          <h3 className="text-lg font-extrabold text-gray-900">{title}</h3> 
          <button onClick={onClose} className="w-8 h-8 bg-gray-100 rounded-full flex items-center justify-center text-gray-500 font-bold text-lg">×</button> 
        </div> 
        {children} 
      </div> 
    </div> 
  ); 
}

function NavItem({ icon: Icon, label, isActive, onClick }) { 
  return ( 
    <button onClick={onClick} className={`flex flex-col items-center justify-center w-16 h-14 rounded-2xl transition-all ${isActive ? 'text-blue-600' : 'text-gray-400 hover:bg-gray-50'}`}> 
      <div className={`relative flex items-center justify-center w-10 h-8 rounded-xl transition-all ${isActive ? 'bg-blue-100' : ''}`}><Icon size={isActive ? 22 : 20} strokeWidth={isActive ? 2.5 : 2} /></div> 
      <span className={`text-[10px] mt-1 font-bold ${isActive ? 'opacity-100' : 'opacity-70'}`}>{label}</span> 
    </button> 
  ); 
}

